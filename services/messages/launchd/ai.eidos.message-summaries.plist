<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>ai.eidos.message-summaries</string>
    <key>Comment</key>
    <string>Eidos message summary processor</string>
    <key>RunAtLoad</key>
    <true/>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>StartInterval</key>
    <integer>15</integer>
    <key>WorkingDirectory</key>
    <string>/Users/oasis/.eidos/services/messages</string>
    <key>ProgramArguments</key>
    <array>
      <string>/usr/bin/ssh</string>
      <string>-i</string>
      <string>/Users/oasis/.eidos/keys/eidos_loopback_ed25519</string>
      <string>-o</string>
      <string>BatchMode=yes</string>
      <string>-o</string>
      <string>StrictHostKeyChecking=accept-new</string>
      <string>-o</string>
      <string>ConnectTimeout=8</string>
      <string>oasis@127.0.0.1</string>
      <string>cd "$HOME/.eidos/services/messages" &amp;&amp; set -a; . "$HOME/.eidos/.env"; set +a; exec /usr/bin/python3 "$HOME/.eidos/services/messages/process_summary_jobs.py" --limit 2</string>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/oasis/.eidos/logs/message-summaries.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/oasis/.eidos/logs/message-summaries.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>HOME</key>
      <string>/Users/oasis</string>
      <key>USER</key>
      <string>oasis</string>
      <key>LOGNAME</key>
      <string>oasis</string>
      <key>SHELL</key>
      <string>/bin/zsh</string>
      <key>EIDOS_HOME</key>
      <string>/Users/oasis/.eidos</string>
      <key>PATH</key>
      <string>/Users/oasis/.local/bin:/Users/oasis/.npm-global/bin:/Users/oasis/bin:/Users/oasis/.volta/bin:/Users/oasis/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
  </dict>
</plist>
